{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(npm test *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(./.env*)",
      "Edit(./.env*)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "WebFetch"
    ],
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "maxEffortLevel": "medium",
  "allowedHttpHookUrls": [
    "http://localhost:*"
  ]
}
