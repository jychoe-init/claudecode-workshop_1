{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(npm test)",
      "Bash(python3 tools/check_lab*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(python3 tools/hr_fetch.py request *)",
      "Bash(python3 tools/hr_fetch.py * request *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.config/superlab/**)",
      "Bash(*.config/superlab*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm -rf *)"
    ]
  }
}
